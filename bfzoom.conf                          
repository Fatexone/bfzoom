server {
  server_name socket.bfzoom.fr;

  # Redirige HTTP -> HTTPS
  listen 80;
  listen [::]:80;
  return 301 https://$host$request_uri;
}

server {
  server_name socket.bfzoom.fr;

  listen 443 ssl http2;
  listen [::]:443 ssl http2;

  # Certbot ajoutera/maintient ces lignes :
  # ssl_certificate     /etc/letsencrypt/live/socket.bfzoom.fr/fullchain.pem;
  # ssl_certificate_key /etc/letsencrypt/live/socket.bfzoom.fr/privkey.pem;

  # Proxy WebSocket vers PM2 (port 4001)
  location /socket.io/ {
    proxy_pass http://127.0.0.1:4001;
    proxy_http_version 1.1;

    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;

    proxy_read_timeout 3600;
    proxy_send_timeout 3600;
  }

  # Healthcheck simple
  location = /health {
    return 200 "ok";

    add_header Content-Type text/plain;
  }

}







