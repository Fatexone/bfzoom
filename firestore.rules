rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function forbiddenUserProfileKeys() {
      return [
        "isPremium",
        "plan",
        "stripeCustomerId",
        "stripeSubscriptionId",
        "role",
        "entitlements",
        "billing",
      ];
    }

    function chatExists(chatId) {
      return exists(/databases/$(database)/documents/chats/$(chatId));
    }

    function isParticipantList(value) {
      return value is list;
    }

    function isChatParticipant(chatId) {
      return isAuthenticated() &&
        chatExists(chatId) &&
        isParticipantList(get(/databases/$(database)/documents/chats/$(chatId)).data.participants) &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    // 👤 Profils utilisateurs
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if isSelf(userId) &&
        !request.resource.data.keys().hasAny(forbiddenUserProfileKeys());
      allow update: if isSelf(userId) &&
        !request.resource.data.diff(resource.data).changedKeys().hasAny(forbiddenUserProfileKeys());
      allow delete: if isSelf(userId);
    }

    match /users/{userId}/chatPreferences/{chatId} {
      allow read, create, update, delete: if isSelf(userId);
    }

    // 🔋 Wallet tokens + logs
    match /users/{userId}/tokens {
      allow read: if isSelf(userId);
      allow create: if isSelf(userId) &&
        request.resource.data.balance == 0 &&
        request.resource.data.tier == "free";
      allow update, delete: if false;
    }

    match /users/{userId}/usage_logs/{logId} {
      allow read: if isSelf(userId);
      allow write: if false;
    }

    // 👥 Liste de contacts
    match /contacts/{userId}/list/{contactId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }

    // 📬 Invitations reçues
    match /invitations/{userId}/received/{invitationId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.fromUid;
    }

    // 💬 Conversations existantes
    match /conversations/{conversationId} {
      allow get, read, update, delete: if request.auth != null &&
        request.auth.uid in resource.data.participants;

      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participants;
    }

    match /conversations/{conversationId}/messages/{messageId} {
      allow read, create: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;

      allow update, delete: if request.auth != null &&
        request.auth.uid == resource.data.senderId;
    }

    // 🧱 Groupes d’expression
    match /groups/{groupId}/messages/{messageId} {
      allow read, create: if request.auth != null;
      allow delete: if request.auth != null &&
        (
          request.auth.token.role == "super_admin" ||
          request.auth.uid == resource.data.userId
        );
    }

    // 💬 Chats (nouveau module)
    match /chats/{chatId} {
      allow get, read: if isChatParticipant(chatId);

      allow create: if isAuthenticated() &&
        isParticipantList(request.resource.data.participants) &&
        request.auth.uid in request.resource.data.participants;

      allow update: if isChatParticipant(chatId);

      allow delete: if false;
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read: if isChatParticipant(chatId);

      allow create: if isChatParticipant(chatId) &&
        request.resource.data.senderId == request.auth.uid;

      allow update, delete: if isChatParticipant(chatId) &&
        request.auth.uid == resource.data.senderId;
    }

    match /chats/{chatId}/reads/{userId} {
      allow read: if isChatParticipant(chatId);

      allow create, update: if isChatParticipant(chatId) && request.auth.uid == userId;
    }

    // 🎙️ Appels vidéo
    match /calls/{chatId} {
      allow read, write: if isChatParticipant(chatId);
    }

    // 📩 Invitations en attente
    match /pending_invites/{inviteId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
  }
}