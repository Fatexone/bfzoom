{
  "name": "bfzoom",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NEXT_DISABLE_ESLINT_PATCH=1 next dev",
    "build": "cross-env NEXT_DISABLE_ESLINT_PATCH=1 next build",
    "start": "cross-env NEXT_DISABLE_ESLINT_PATCH=1 next start",
    "lint": "cross-env NEXT_DISABLE_ESLINT_PATCH=1 eslint --ext .ts,.tsx,.js,.jsx src server",
    "check:all": "npm run lint && npm run build && npm --prefix mobile run typecheck && npm --prefix functions run build",
    "check:prod-api": "bash ./scripts/check_prod_api.sh",
    "socket": "node server/socket/index.js",
    "vercel:deploy": "vercel --prod",
    "render:deploy": "git push render main"
  },
  "dependencies": {
    "@livekit/components-react": "^2.9.19",
